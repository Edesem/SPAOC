{
  "name": "st-paul-parish-app",
  "main": "expo-router/entry",
  "version": "2.1.0",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "lint": "expo lint .",
    "typecheck": "npx tsc --noEmit",
    "coverage": "jest --runInBand --coverage --coverageThreshold='{\"global\":{\"lines\":80}}'",
    "build-ios": "eas build --platform ios --profile production --local",
    "build-android": "eas build --platform android --profile production --local"
  },
  "jest": {
    "preset": "jest-expo",
    "testTimeout": 15000,
    "globalSetup": "<rootDir>/jest.global-setup.js",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "collectCoverageFrom": [
      "src/app/**/*.{ts,tsx}",
      "src/components/**/*.{ts,tsx}",
      "src/domain/**/*.{ts,tsx}",
      "src/hooks/**/*.{ts,tsx}",
      "src/services/**/*.{ts,tsx}",
      "src/features/**/*.{ts,tsx}",
      "src/config/**/*.{ts,tsx}",
      "src/lib/**/*.{ts,tsx}",
      "!**/*.test.{ts,tsx}",
      "!**/*.d.ts",
      "!**/constants.ts"
    ]
  },
  "dependencies": {
    "@config-plugins/react-native-blob-util": "^14.0.2",
    "@config-plugins/react-native-pdf": "^14.0.2",
    "@expo-google-fonts/alegreya": "^0.4.2",
    "@expo-google-fonts/alegreya-sans": "^0.4.2",
    "@expo-google-fonts/alegreya-sc": "^0.4.2",
    "@expo/ui": "~57.0.22",
    "@expo/vector-icons": "15.0.3",
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-native-fontawesome": "^0.3.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/native": "^7.0.14",
    "@types/he": "^1.2.3",
    "axios": "^1.7.9",
    "expo": "^57.0.0",
    "expo-build-properties": "~57.0.22",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.9",
    "expo-dev-client": "~57.0.10",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-linking": "~57.0.5",
    "expo-localization": "~57.0.1",
    "expo-notifications": "~57.0.9",
    "expo-router": "~57.0.11",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~58.0.6",
    "he": "^1.2.0",
    "html-entities": "^2.5.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-blob-util": "^0.25.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-pdf": "^7.0.5",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-toast-message": "^2.3.0",
    "react-native-vector-icons": "^10.2.0",
    "react-native-web": "^0.21.0",
    "titlecase": "^1.1.3",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.4",
    "@types/react-native-push-notification": "^8.1.4",
    "@types/react-native-vector-icons": "^6.4.18",
    "@types/react-test-renderer": "^18.3.0",
    "@types/titlecase": "^1.1.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.1",
    "jest": "^29.2.1",
    "jest-expo": "~57.0.3",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "private": true,
  "packageManager": "npm@11.13.0",
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "enabled": false,
        "exclude": {
          "react-native-vector-icons": "^10.2.0"
        },
        "listUnknownPackages": true
      }
    }
  }
}
