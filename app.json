{
  "expo": {
    "name": "SPAOC",
    "slug": "St-Paul-Parish-App",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "assets/images/android-logo-primary.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "icon": "assets/images/spaoc-white-background.icon",
      "bundleIdentifier": "com.edesem.StPaulParishApp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": ["comgooglemaps", "waze"]
      }
    },
    "android": {
      "package": "com.edesem.StPaulParishApp"
    },
    "web": {
      "splash": {
        "image": "assets/images/stpauls-wireframe-logo.png",
        "resizeMode": "contain",
        "backgroundColor": "#121212"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "assets/images/spaoc-primary.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "assets/images/spaoc-secondary.png",
            "backgroundColor": "#121212"
          }
        }
      ]

    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "6951e8d5-1ff3-4e22-ba40-aa6341adf62f"
      }
    }
  }
}