{
  "expo": {
    "name": "SPAOC",
    "slug": "St-Paul-Parish-App",
    "version": "2.0.0",
    "orientation": "default",
    "icon": "assets/images/android-logo-primary.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "icon": "assets/images/spaoc-white-background.icon",
      "bundleIdentifier": "com.edesem.StPaulParishApp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": ["comgooglemaps", "waze"]
      }
    },
    "android": {
      "package": "com.edesem.StPaulParishApp"
    },
    "web": {
      "splash": {
        "image": "assets/images/stpauls-wireframe-logo.png",
        "resizeMode": "contain",
        "backgroundColor": "#121212"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "assets/images/spaoc-primary.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "assets/images/spaoc-secondary.png",
            "backgroundColor": "#121212"
          }
        }
      ],
      [
        "expo-font",
        {
          "ios": {
            "fonts": [
              "node_modules/@expo-google-fonts/alegreya/400Regular/Alegreya_400Regular.ttf",
              "node_modules/@expo-google-fonts/alegreya/400Regular_Italic/Alegreya_400Regular_Italic.ttf",
              "node_modules/@expo-google-fonts/alegreya/700Bold/Alegreya_700Bold.ttf",
              "node_modules/@expo-google-fonts/alegreya-sans/400Regular/AlegreyaSans_400Regular.ttf",
              "node_modules/@expo-google-fonts/alegreya-sans/400Regular_Italic/AlegreyaSans_400Regular_Italic.ttf",
              "node_modules/@expo-google-fonts/alegreya-sans/500Medium/AlegreyaSans_500Medium.ttf",
              "node_modules/@expo-google-fonts/alegreya-sans/700Bold/AlegreyaSans_700Bold.ttf",
              "node_modules/@expo-google-fonts/alegreya-sc/400Regular_Italic/AlegreyaSC_400Regular_Italic.ttf",
              "node_modules/@expo-google-fonts/alegreya-sc/700Bold/AlegreyaSC_700Bold.ttf"
            ]
          },
          "android": {
            "fonts": [
              {
                "fontFamily": "Alegreya",
                "fontDefinitions": [
                  {
                    "path": "node_modules/@expo-google-fonts/alegreya/400Regular/Alegreya_400Regular.ttf",
                    "weight": 400,
                    "style": "normal"
                  },
                  {
                    "path": "node_modules/@expo-google-fonts/alegreya/400Regular_Italic/Alegreya_400Regular_Italic.ttf",
                    "weight": 400,
                    "style": "italic"
                  },
                  {
                    "path": "node_modules/@expo-google-fonts/alegreya/700Bold/Alegreya_700Bold.ttf",
                    "weight": 700,
                    "style": "normal"
                  }
                ]
              },
              {
                "fontFamily": "Alegreya Sans",
                "fontDefinitions": [
                  {
                    "path": "node_modules/@expo-google-fonts/alegreya-sans/400Regular/AlegreyaSans_400Regular.ttf",
                    "weight": 400,
                    "style": "normal"
                  },
                  {
                    "path": "node_modules/@expo-google-fonts/alegreya-sans/400Regular_Italic/AlegreyaSans_400Regular_Italic.ttf",
                    "weight": 400,
                    "style": "italic"
                  },
                  {
                    "path": "node_modules/@expo-google-fonts/alegreya-sans/500Medium/AlegreyaSans_500Medium.ttf",
                    "weight": 500,
                    "style": "normal"
                  },
                  {
                    "path": "node_modules/@expo-google-fonts/alegreya-sans/700Bold/AlegreyaSans_700Bold.ttf",
                    "weight": 700,
                    "style": "normal"
                  }
                ]
              },
              {
                "fontFamily": "Alegreya SC",
                "fontDefinitions": [
                  {
                    "path": "node_modules/@expo-google-fonts/alegreya-sc/400Regular_Italic/AlegreyaSC_400Regular_Italic.ttf",
                    "weight": 400,
                    "style": "italic"
                  },
                  {
                    "path": "node_modules/@expo-google-fonts/alegreya-sc/700Bold/AlegreyaSC_700Bold.ttf",
                    "weight": 700,
                    "style": "normal"
                  }
                ]
              }
            ]
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      "@config-plugins/react-native-blob-util",
      "@config-plugins/react-native-pdf"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "6951e8d5-1ff3-4e22-ba40-aa6341adf62f"
      }
    }
  }
}
