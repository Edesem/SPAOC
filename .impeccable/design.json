  "components": [
    {
      "name": "Event Row",
      "kind": "card",
      "refersTo": "event-row",
      "description": "A day's event: calendar bar, time, title, favourite star and chevron.",
      "html": "<div class=\"ds-event\"><div class=\"ds-event-bar\"></div><div class=\"ds-event-body\"><div class=\"ds-event-time\">6:00 PM – 7:30 PM</div><div class=\"ds-event-title\">Youth Night</div></div><div class=\"ds-event-actions\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#BBBBBB\" stroke-width=\"1.6\" aria-hidden=\"true\"><path d=\"m12 3 2.7 5.6 6.1.8-4.5 4.3 1.1 6.1L12 17l-5.4 2.8 1.1-6.1L3.2 9.4l6.1-.8z\"/></svg><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"#BBBBBB\" aria-hidden=\"true\"><path d=\"M8.6 16.6 13.2 12 8.6 7.4 10 6l6 6-6 6z\"/></svg></div></div>",
      "css": ".ds-event{display:flex;align-items:center;background:#fff;border-radius:8px;padding:20px;margin:2px 16px;box-shadow:0 2px 4px rgba(0,0,0,.2);font-family:-apple-system,Roboto,system-ui,sans-serif}.ds-event-bar{width:8px;align-self:stretch;margin-right:10px;background:#3F51B5;border-radius:8px 1px 8px 1px}.ds-event-body{flex:1}.ds-event-time{font-size:14px;color:#777;margin-bottom:2px}.ds-event-title{font-size:18px;color:#333}.ds-event-actions{display:flex;align-items:center;gap:12px}.ds-event:hover{background:#faf9fa}.ds-event:focus-visible{outline:2px solid #0a4068;outline-offset:2px}"
    },
    {
      "name": "Reading Card",
      "kind": "card",
      "refersTo": "reading-card",
      "description": "Daily reading title and teaser; tapping opens the full text.",
      "html": "<div class=\"ds-reading\"><div class=\"ds-reading-head\"><h3 class=\"ds-reading-title\">Epistle</h3><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"#BBBBBB\" aria-hidden=\"true\"><path d=\"M8.6 16.6 13.2 12 8.6 7.4 10 6l6 6-6 6z\"/></svg></div><div class=\"ds-reading-divider\"></div><p class=\"ds-reading-teaser\">Brethren, I make known to you the gospel I preached to you…</p></div>",
      "css": ".ds-reading{background:#fff;border-radius:10px;padding:20px;margin:20px;box-shadow:0 3px 4px rgba(0,0,0,.1);font-family:-apple-system,Roboto,system-ui,sans-serif}.ds-reading-head{display:flex;justify-content:space-between;align-items:flex-start}.ds-reading-title{margin:0 0 15px;font-size:24px;font-weight:600;color:#333}.ds-reading-divider{height:3px;background:#a88646;margin:10px 0}.ds-reading-teaser{margin:0;font-size:16px;line-height:24px;color:#333}.ds-reading:hover{background:#faf9fa}"
    },
