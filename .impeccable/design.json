  "components": [
    {
      "name": "Event Row",
      "kind": "card",
      "refersTo": "event-row",
      "description": "A day's event: calendar bar, time, title, favourite star and chevron.",
      "html": "<div class=\"ds-event\"><div class=\"ds-event-bar\"></div><div class=\"ds-event-body\"><div class=\"ds-event-time\">6:00 PM – 7:30 PM</div><div class=\"ds-event-title\">Youth Night</div></div><div class=\"ds-event-actions\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#8C8C8C\" stroke-width=\"1.6\" aria-hidden=\"true\"><path d=\"m12 3 2.7 5.6 6.1.8-4.5 4.3 1.1 6.1L12 17l-5.4 2.8 1.1-6.1L3.2 9.4l6.1-.8z\"/></svg><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"#8C8C8C\" aria-hidden=\"true\"><path d=\"M8.6 16.6 13.2 12 8.6 7.4 10 6l6 6-6 6z\"/></svg></div></div>",
      "css": ".ds-event{display:flex;align-items:center;background:#fff;border-radius:8px;padding:20px;margin:2px 16px;box-shadow:0 2px 4px rgba(0,0,0,.2);font-family:-apple-system,Roboto,system-ui,sans-serif}.ds-event-bar{width:8px;align-self:stretch;margin-right:10px;background:#3F51B5;border-radius:8px 1px 8px 1px}.ds-event-body{flex:1}.ds-event-time{font-size:14px;color:#666;margin-bottom:2px}.ds-event-title{font-size:18px;color:#333}.ds-event-actions{display:flex;align-items:center;gap:12px}.ds-event:hover{background:#faf9fa}.ds-event:focus-visible{outline:2px solid #0a4068;outline-offset:2px}"
    },
    {
      "name": "Reading Card",
      "kind": "card",
      "refersTo": "reading-card",
      "description": "Daily reading title and teaser; tapping opens the full text.",
      "html": "<div class=\"ds-reading\"><div class=\"ds-reading-head\"><h3 class=\"ds-reading-title\">Epistle</h3><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"#8C8C8C\" aria-hidden=\"true\"><path d=\"M8.6 16.6 13.2 12 8.6 7.4 10 6l6 6-6 6z\"/></svg></div><div class=\"ds-reading-divider\"></div><p class=\"ds-reading-teaser\">Brethren, I make known to you the gospel I preached to you…</p></div>",
      "css": ".ds-reading{background:#fff;border-radius:10px;padding:20px;margin:20px;box-shadow:0 3px 4px rgba(0,0,0,.1);font-family:-apple-system,Roboto,system-ui,sans-serif}.ds-reading-head{display:flex;justify-content:space-between;align-items:flex-start}.ds-reading-title{margin:0 0 15px;font-size:24px;font-weight:600;color:#333}.ds-reading-divider{height:3px;background:#a88646;margin:10px 0}.ds-reading-teaser{margin:0;font-size:16px;line-height:24px;color:#333}.ds-reading:hover{background:#faf9fa}"
    },
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Bronze action button, centred at 80% width.",
      "html": "<button class=\"ds-btn-primary\">Save</button>",
      "css": ".ds-btn-primary{width:80%;display:block;margin:0 auto;padding:15px 0;background:#a88646;color:#121212;border:0;border-radius:10px;font:600 16px -apple-system,Roboto,system-ui,sans-serif;box-shadow:0 2px 3px rgba(0,0,0,.1);cursor:pointer}.ds-btn-primary:hover{background:#b8975a}.ds-btn-primary:focus-visible{outline:2px solid #0a4068;outline-offset:2px}.ds-btn-primary:active{transform:scale(.99)}"
    },
    {
      "name": "Donate Button",
      "kind": "button",
      "refersTo": "button-donate",
      "description": "The only red in the chrome; used for giving.",
      "html": "<button class=\"ds-btn-donate\">Donate via Square</button>",
      "css": ".ds-btn-donate{width:100%;padding:15px 0;background:#de333f;color:#fff;border:0;border-radius:10px;font:600 16px -apple-system,Roboto,system-ui,sans-serif;cursor:pointer}.ds-btn-donate:hover{background:#c92c37}.ds-btn-donate:focus-visible{outline:2px solid #0a4068;outline-offset:2px}"
    },
    {
      "name": "Link Row",
      "kind": "button",
      "refersTo": "link-row",
      "description": "About-screen outbound link: icon and label in the lead accent.",
      "html": "<a class=\"ds-link\" href=\"#\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"#0a4068\" aria-hidden=\"true\"><path d=\"M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm6.9 9h-3a15.7 15.7 0 0 0-1.4-6A8 8 0 0 1 18.9 11ZM12 4c.8 1 1.6 3 1.9 7h-3.8c.3-4 1.100-6 1.900-7ZM4.1 13h3a15.700 15.700 0 0 0 1.400 6A8 8 0 0 1 4.100 13Zm3-2h-3a8 8 0 0 1 4.400-6 15.700 15.700 0 0 0-1.400 6ZM12 20c-.8-1-1.600-3-1.900-7h3.800c-.3 4-1.100 6-1.900 7Zm2.500-1a15.700 15.700 0 0 0 1.400-6h3a8 8 0 0 1-4.400 6Z\"/></svg><span>Visit our Website</span></a>",
      "css": ".ds-link{display:flex;align-items:center;gap:12px;padding:10px 16px;border-radius:12px;color:#0a4068;text-decoration:none;font:500 16px -apple-system,Roboto,system-ui,sans-serif}.ds-link:hover{background:rgba(10,64,104,.06)}.ds-link:focus-visible{outline:2px solid #0a4068;outline-offset:2px}"
    },
    {
      "name": "Clear Filter Pill",
      "kind": "chip",
      "refersTo": "clear-filter",
      "description": "Navy pill shown when the month filter is active.",
      "html": "<button class=\"ds-pill\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"#fff\" aria-hidden=\"true\"><path d=\"M19 6.400 17.600 5 12 10.600 6.400 5 5 6.400 10.600 12 5 17.600 6.400 19 12 13.400 17.600 19 19 17.600 13.400 12z\"/></svg>Clear month filter</button>",
      "css": ".ds-pill{display:inline-flex;align-items:center;gap:6px;padding:10px 18px;border:0;border-radius:20px;background:#0a4068;color:#fff;font:700 16px -apple-system,Roboto,system-ui,sans-serif;cursor:pointer}.ds-pill:hover{background:#08334f}.ds-pill:focus-visible{outline:2px solid #a88646;outline-offset:2px}"
    },
    {
      "name": "Tab Bar",
